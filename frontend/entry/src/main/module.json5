{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "skillProfiles": [
      {
        "name": "pureyes-investigation",
        "abilityName": "EntryAbility",
        "version": "1.0.0",
        "visibility": "system",
        "srcEntries": ["../../skills/pureyes-investigation/scripts/InvestigationSkill.ets"]
      }
    ],
    "metadata": [
      { "name": "ohos.arkui.UIMaterial.state", "value": "enable" }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.DLP_GET_HIDE_STATUS"
      },
      {
        "name": "ohos.permission.DISTRIBUTED_DATASYNC",
        "reason": "$string:investigation_continue_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.VIBRATE"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.FLOAT_VIEW",
        "reason": "$string:investigation_float_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.USE_FLOAT_BALL"
      },
      {
        "name": "ohos.permission.PRIVACY_WINDOW",
        "reason": "$string:privacy_window_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "continuable": true,
        "supportWindowMode": ["fullscreen", "split", "floating"],
        "backgroundModes": ["dataTransfer"],
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "actions": ["ohos.want.action.sendData"],
            "uris": [{ "scheme": "file", "utd": "general.video", "maxFileSupported": 5 }]
          },
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "InvestigationLiveFormAbility",
        "srcEntry": "./ets/investigationform/InvestigationLiveFormAbility.ets",
        "type": "liveForm",
        "exported": false
      },
      {
        "name": "InvestigationFormAbility",
        "srcEntry": "./ets/investigationform/InvestigationFormAbility.ets",
        "label": "$string:investigation_card_name",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:investigation_form_config"
          }
        ]
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}
